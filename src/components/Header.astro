---
import { profile } from '../data/site';
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${profile.name} home`}>
      <span class="brand-mark">{profile.initials.slice(0, 1)}</span>
      <span><strong>{profile.name}</strong><small>{profile.role}</small></span>
    </a>
    <nav aria-label="Primary navigation">
      <a href="/#writing">Writing</a>
      <a href="/about/">About</a>
      <a class="header-cta" href="mailto:">Let's talk <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
