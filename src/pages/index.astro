---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/site';

const posts = (await getCollection('blog', ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title={`${profile.name} | Blog`} description={profile.bio}>
  <section class="hero shell">
    <div class="eyebrow"><i></i> Engineering notes · {profile.location}</div>
    <h1>Ideas, experiments,<br /><em>and lessons.</em></h1>
    <p class="hero-summary">{profile.bio}</p>
    <a class="button" href="#writing">Read the latest <span>↓</span></a>
  </section>

  <section class="section shell" id="writing" aria-labelledby="writing-title">
    <div class="section-intro"><div><span class="section-kicker">01 / Field notes</span><h2 id="writing-title">Recent <em>writing.</em></h2></div><p>{posts.length} articles spanning a decade of software development.</p></div>
    <div class="post-list">
      {posts.map((post, index) => (
        <article class="post-row">
          <span class="post-index">{String(index + 1).padStart(2, '0')}</span>
          <div class="post-copy"><div class="post-meta"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>{post.data.tags.slice(0, 2).map((tag) => <span>{tag}</span>)}</div><h3><a href={post.data.permalink}>{post.data.title}</a></h3></div>
          <a class="post-arrow" href={post.data.permalink} aria-label={`Read ${post.data.title}`}>↗</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
