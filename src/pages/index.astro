---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());
---
<BaseLayout title={`${profile.name} | Blog`} description={profile.bio}>
  <section class="hero shell" aria-labelledby="hero-title">
    <p class="eyebrow">{profile.title} · {profile.location}</p>
    <h1 id="hero-title">Engineering leadership<br /><em>with context.</em></h1>
    <p class="hero-summary">{profile.bio}</p>
    <nav class="social-row" aria-label="Social links"><a href={profile.linkedin}>LinkedIn</a><a href={profile.github}>GitHub</a><a href={profile.linkedin}>Contact</a><a href="/rss.xml">RSS</a></nav>
  </section>

  <section class="proof-strip" aria-label="Professional experience">
    <div class="shell proof-grid">
      <div><strong>20+</strong><span>years in software</span></div>
      <div><strong>3</strong><span>technical books</span></div>
      <div><strong>9+</strong><span>public speaking engagements</span></div>
      <div><strong>75</strong><span>published articles</span></div>
    </div>
  </section>

  <section class="section shell" id="blog" aria-labelledby="writing-title">
    <div class="section-intro"><div><span class="section-kicker">Writing</span><h2 id="writing-title">Recent posts</h2></div><p>{posts.length} essays on technology, culture, and the work of building software.</p></div>
    <div class="post-list" role="list">
      {posts.map((post, index) => (
        <article class="post-row" role="listitem">
          <span class="post-index">{String(index + 1).padStart(2, '0')}</span>
          <div class="post-copy"><div class="post-meta"><time datetime={post.data.pubDatetime.toISOString()}>{post.data.pubDatetime.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>{post.data.tags.slice(0, 2).map((tag) => <span>{tag}</span>)}</div><h3><a href={post.data.permalink || `/${post.id}/`}>{post.data.title}</a></h3></div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
