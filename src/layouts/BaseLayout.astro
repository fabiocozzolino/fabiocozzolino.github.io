---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const { title = "Fabio Cozzolino — Engineering leadership with context",
  description = "VP of Engineering in Italy. Essays on engineering leadership, architecture, and the culture of building software." } = Astro.props;
---
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:type" content="website" /><meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" />
</head>
<body>
  <div class="glow glow-1"></div><div class="glow glow-2"></div>
  <Header /><main class="wrap"><slot /></main><Footer />
  <dialog class="image-lightbox" data-image-lightbox aria-label="Image preview">
    <button type="button" class="image-lightbox-close" data-image-lightbox-close aria-label="Close image preview">Close</button>
    <img data-image-lightbox-content alt="" />
  </dialog>
  <script>
    const setupImageLightbox = () => {
      const lightbox = document.querySelector<HTMLDialogElement>('[data-image-lightbox]');
      const preview = document.querySelector<HTMLImageElement>('[data-image-lightbox-content]');
      if (!lightbox || !preview || lightbox.dataset.ready) return;
      lightbox.dataset.ready = 'true';
      const close = () => lightbox.close();
      document.querySelectorAll<HTMLImageElement>('.article-body img').forEach((image) => {
        image.tabIndex = 0;
        image.setAttribute('role', 'button');
        image.setAttribute('aria-label', `Open full-size image: ${image.alt || 'image'}`);
        const open = () => { preview.src = image.srcset?.split(',').at(-1)?.trim().split(/\s+/)[0] || image.src; preview.alt = image.alt || 'Full-size article image'; lightbox.showModal(); };
        image.addEventListener('click', open);
        image.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); open(); } });
      });
      document.querySelector('[data-image-lightbox-close]')?.addEventListener('click', close);
      lightbox.addEventListener('click', (event) => { if (event.target === lightbox) close(); });
    };
    setupImageLightbox();
    document.addEventListener('astro:page-load', setupImageLightbox);
  </script>
</body>
</html>
