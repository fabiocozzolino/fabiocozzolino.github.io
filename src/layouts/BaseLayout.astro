---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const { title = `${profile.name} | ${profile.title}`, description = profile.bio, type = 'website', image = '/assets/img/fabio.jpeg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <script is:inline>document.documentElement.dataset.theme = localStorage.getItem('theme') === 'light' ? 'light' : 'dark';</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.ico" />
    <meta name="author" content={profile.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={`${profile.name} - ${profile.title}`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="page-noise" aria-hidden="true"></div>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <dialog class="image-lightbox" data-image-lightbox aria-label="Image preview">
      <button type="button" class="image-lightbox-close" data-image-lightbox-close aria-label="Close image preview">Close</button>
      <img data-image-lightbox-content alt="" />
    </dialog>
    <script>
      const setupImageLightbox = () => {
        const lightbox = document.querySelector<HTMLDialogElement>('[data-image-lightbox]');
        const preview = document.querySelector<HTMLImageElement>('[data-image-lightbox-content]');
        if (!lightbox || !preview || lightbox.dataset.ready) return;
        lightbox.dataset.ready = 'true';

        const close = () => {
          lightbox.close();
          preview.removeAttribute('src');
          preview.alt = '';
        };

        document.querySelectorAll<HTMLImageElement>('.article-body img').forEach((image) => {
          image.setAttribute('tabindex', '0');
          image.setAttribute('role', 'button');
          image.setAttribute('aria-label', `Open full-size image: ${image.alt || 'image'}`);
          const open = () => {
            const largestSrc = image.srcset?.split(',').at(-1)?.trim().split(/\s+/)[0];
            preview.src = image.dataset.fullSrc || largestSrc || image.src;
            preview.alt = image.alt || 'Full-size article image';
            lightbox.showModal();
          };
          image.addEventListener('click', open);
          image.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              open();
            }
          });
        });

        document.querySelector('[data-image-lightbox-close]')?.addEventListener('click', close);
        lightbox.addEventListener('click', (event) => {
          if (event.target === lightbox) close();
        });
        lightbox.addEventListener('close', () => {
          preview.removeAttribute('src');
        });
      };
      setupImageLightbox();
      document.addEventListener('astro:page-load', setupImageLightbox);
    </script>
  </body>
</html>
